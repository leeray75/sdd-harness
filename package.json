{
  "name": "sdd-harness",
  "version": "0.1.0",
  "description": "SDD Harness: a desktop app for the spec-driven workflow",
  "private": true,
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "e2e": "pnpm build && playwright test",
    "record:spike": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/record-spike-fixture.ts",
    "record:probes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts-resolve.mjs scripts/record-probe-fixtures.ts",
    "secrets:set": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/secrets.ts set",
    "secrets:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/secrets.ts list",
    "secrets:delete": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/secrets.ts delete",
    "package": "pnpm build && electron-builder --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "openai": "^7.59.0"
  }
}
